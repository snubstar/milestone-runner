{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/snubstar/automation/schemas/state.schema.json",
  "title": "Agent Milestone Orchestrator State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "goal",
    "currentPhase",
    "status",
    "currentMilestoneId",
    "artifactRoot",
    "runDir",
    "git",
    "config",
    "milestoneStatuses",
    "fixAttempts",
    "artifacts",
    "lastError",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocationCwd", "targetCwd"],
      "properties": {
        "invocationCwd": {
          "type": "string",
          "minLength": 1
        },
        "targetCwd": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "currentPhase": {
      "$ref": "#/$defs/phase"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "currentMilestoneId": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "artifactRoot": {
      "type": "string",
      "minLength": 1
    },
    "runDir": {
      "type": "string",
      "minLength": 1
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "planningOnly",
        "root",
        "startSha",
        "dirtyAtStart",
        "dirtyOverride",
        "statusPorcelain"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "planningOnly": {
          "type": "boolean"
        },
        "root": {
          "type": ["string", "null"]
        },
        "startSha": {
          "type": ["string", "null"]
        },
        "dirtyAtStart": {
          "type": "boolean"
        },
        "dirtyOverride": {
          "type": "boolean"
        },
        "statusPorcelain": {
          "type": "string"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "snapshot"],
      "properties": {
        "path": {
          "type": ["string", "null"]
        },
        "snapshot": {
          "type": ["object", "null"],
          "additionalProperties": true
        }
      }
    },
    "milestoneStatuses": {
      "type": "object",
      "description": "Map of milestone id to orchestration status.",
      "additionalProperties": {
        "$ref": "#/$defs/milestoneStatus"
      }
    },
    "fixAttempts": {
      "type": "object",
      "description": "Map of milestone id to completed fix attempt count.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "artifacts": {
      "$ref": "#/$defs/artifacts"
    },
    "lastError": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["message", "phase", "occurredAt"],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "$ref": "#/$defs/phase"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "details": {
          "type": ["string", "object", "array", "null"]
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "phase": {
      "type": "string",
      "enum": [
        "initialized",
        "planning",
        "plan_reviewing",
        "ready_for_milestone",
        "ready_for_review",
        "implementing",
        "checking",
        "reviewing",
        "fixing",
        "passed",
        "failed",
        "needs_human_review"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "initialized",
        "planning",
        "plan_reviewing",
        "ready_for_milestone",
        "ready_for_review",
        "implementing",
        "checking",
        "reviewing",
        "fixing",
        "passed",
        "failed",
        "needs_human_review"
      ]
    },
    "milestoneStatus": {
      "type": "string",
      "enum": [
        "pending",
        "planned",
        "ready_for_review",
        "implementing",
        "checking",
        "reviewing",
        "fixing",
        "passed",
        "failed",
        "needs_human_review"
      ]
    },
    "artifactPath": {
      "type": "string",
      "minLength": 1
    },
    "artifactMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/artifactPath"
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goalSource", "context"],
      "properties": {
        "goalSource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["argv", "file"]
            },
            "path": {
              "type": ["string", "null"]
            }
          }
        },
        "majorPlanSource": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "path"],
              "properties": {
                "type": {
                  "const": "runner"
                },
                "path": {
                  "type": "null"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "path", "sizeBytes", "sha256"],
              "properties": {
                "type": {
                  "const": "seed"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "context": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "artifactPath", "sizeBytes", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "artifactPath": {
                "$ref": "#/$defs/artifactPath"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "inputArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest"],
      "properties": {
        "manifest": {
          "$ref": "#/$defs/artifactPath"
        },
        "context": {
          "$ref": "#/$defs/artifactMap"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goal": {
          "$ref": "#/$defs/artifactPath"
        },
        "inputs": {
          "$ref": "#/$defs/inputArtifacts"
        },
        "majorPlan": {
          "$ref": "#/$defs/artifactPath"
        },
        "majorPlanReview": {
          "$ref": "#/$defs/artifactPath"
        },
        "finalMajorPlanMarkdown": {
          "$ref": "#/$defs/artifactPath"
        },
        "finalMajorPlanJson": {
          "$ref": "#/$defs/artifactPath"
        },
        "milestones": {
          "$ref": "#/$defs/artifactPath"
        },
        "milestonePlanDrafts": {
          "$ref": "#/$defs/artifactMap"
        },
        "milestonePlanReviews": {
          "$ref": "#/$defs/artifactMap"
        },
        "milestonePlans": {
          "$ref": "#/$defs/artifactMap"
        },
        "implementations": {
          "$ref": "#/$defs/artifactMap"
        },
        "diffs": {
          "$ref": "#/$defs/artifactMap"
        },
        "checks": {
          "$ref": "#/$defs/artifactMap"
        },
        "reviews": {
          "$ref": "#/$defs/artifactMap"
        },
        "summaries": {
          "$ref": "#/$defs/artifactMap"
        },
        "fixes": {
          "$ref": "#/$defs/artifactMap"
        },
        "logs": {
          "$ref": "#/$defs/artifactMap"
        }
      }
    }
  }
}
